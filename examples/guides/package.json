{
  "name": "agentboxd-guide-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable examples for the integration guides on agentboxd.com/guides",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mcp:smoke": "tsx mcp-email-server/smoke.ts",
    "openclaw:check": "tsx openclaw/validate.ts",
    "vercel-ai": "tsx vercel-ai-sdk-email-tools/agent.ts",
    "vercel-ai:smoke": "tsx vercel-ai-sdk-email-tools/smoke.ts",
    "demo-app": "tsx playwright-email-verification/demo-app.ts",
    "test:e2e": "playwright test -c playwright-email-verification/playwright.config.ts",
    "n8n:check": "tsx n8n-email-automation/workflows.ts --check",
    "self-signup": "tsx agent-self-signup/signup.ts",
    "self-signup:smoke": "tsx agent-self-signup/smoke.ts",
    "sim:check": "tsx sim-email-workflows/validate.ts",
    "sim:smoke": "tsx sim-email-workflows/validate.ts --smoke",
    "replit:smoke": "tsx replit-email-agent/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.75",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ai": "7.0.114",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
