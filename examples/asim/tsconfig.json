{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // Imports of `agentboxd` resolve to the SDK source in this repository. In your own project:
    // `npm install agentboxd jose canonicalize` and drop this mapping.
    "paths": {
      "agentboxd": ["../../sdk/src/index.ts"],
      "agentboxd/identity": ["../../sdk/src/identity.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
